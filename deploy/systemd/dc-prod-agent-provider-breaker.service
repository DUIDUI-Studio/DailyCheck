# deploy/systemd/dc-prod-agent-provider-breaker.service
#
# One-shot scan of newly appended Hermes error-log bytes. The Python scanner
# atomically persists its cursor and applies the reducer provider cooldown.

[Unit]
Description=DailyCheck Prod Agent provider-quota breaker (Issue #54)
After=dc-inbox-watcher.service
ConditionPathExists=/root/DailyCheck/scripts/prod_agent/provider_breaker.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/DailyCheck
Environment="PATH=/root/DailyCheck/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
Environment=DAILYCHECK_EVENT_REDUCER_DB=/var/lib/dailycheck-prod-agent/event_reducer.sqlite3

ExecStart=/root/DailyCheck/.venv/bin/python /root/DailyCheck/scripts/prod_agent/provider_breaker.py --log /root/.hermes/logs/errors.log --state /var/lib/dailycheck-prod-agent/provider_breaker_state.json
TimeoutStartSec=60

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dailycheck-prod-agent
PrivateTmp=true
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
