# Preparation only: never install/enable as part of the transport change.
# Separate loopback listener and state directory; no production watcher dependency.
[Unit]
Description=DailyCheck GitHub webhook shadow intake
After=network.target

[Service]
Type=simple
User=root
Group=root
StateDirectory=dailycheck-github-shadow
WorkingDirectory=/var/lib/dailycheck-github-shadow
EnvironmentFile=/etc/dailycheck/github-shadow.env
Environment=DAILYCHECK_HOSTING_PROVIDER=github
Environment=DAILYCHECK_GITHUB_SHADOW_DIR=/var/lib/dailycheck-github-shadow
Environment=INBOX_PATH=/var/lib/dailycheck-github-shadow/inbox.jsonl
Environment=PROCESSED_PATH=/var/lib/dailycheck-github-shadow/processed.jsonl
ExecStart=/bin/sh -c 'exec "$DAILYCHECK_SOURCE_DIR/.venv/bin/python" -m gunicorn --chdir "$DAILYCHECK_SOURCE_DIR" -w 1 --threads 4 -b 127.0.0.1:8444 scripts.blue_green.webhook_receiver:app'
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dailycheck-github-shadow
PrivateTmp=true

# No Install section: activation is a separate Owner/Prod decision.
