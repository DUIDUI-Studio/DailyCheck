# Disabled example only. Installation and production cutover require Prod authorization.
DAILYCHECK_HOSTING_PROVIDER=gitea
DAILYCHECK_GITHUB_LANE=shadow
DAILYCHECK_GITHUB_REPO=DUIDUI-Studio/DailyCheck
DAILYCHECK_GITHUB_READ_TOKEN_FILE=
DAILYCHECK_GITHUB_REPORT_TOKEN_FILE=
# Prod-selected finalization credential, separate from read/report/Dev credentials.
DAILYCHECK_GITHUB_FINALIZE_TOKEN_FILE=
