# DAILYCHECK_PROD_REPO=/root/DailyCheck
# DAILYCHECK_DEPLOY_STATE_DIR=/var/lib/dailycheck-deploy
# DAILYCHECK_DEPLOY_EVENT_LOG=/var/lib/dailycheck-deploy/events.jsonl
# DAILYCHECK_PROD_AGENT_INBOX=/var/lib/dailycheck-prod-agent/inbox.jsonl
