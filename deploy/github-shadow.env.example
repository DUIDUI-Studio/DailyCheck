# Reviewable template only; do not source into an existing production service.
DAILYCHECK_SOURCE_DIR=/opt/dailycheck
DAILYCHECK_HOSTING_PROVIDER=github
DAILYCHECK_GITHUB_API=https://api.github.com
DAILYCHECK_GITHUB_REPO=DUIDUI-Studio/DailyCheck
DAILYCHECK_GITHUB_READ_TOKEN_FILE=/etc/dailycheck/github-read-token
DAILYCHECK_GITHUB_SHADOW_DIR=/var/lib/dailycheck-github-shadow
INBOX_PATH=/var/lib/dailycheck-github-shadow/inbox.jsonl
PROCESSED_PATH=/var/lib/dailycheck-github-shadow/processed.jsonl
DAILYCHECK_DEPLOY_EVENT_LOG=/var/lib/dailycheck-github-shadow/events.jsonl
DAILYCHECK_PROD_AGENT_INBOX=/var/lib/dailycheck-github-shadow/inbox.jsonl
# WEBHOOK_SECRET must be provisioned separately; absent = receipt fails closed.
# Feedback/report WRITE roles have NO fallback to READ/GH_TOKEN/gh login:
# DAILYCHECK_GITHUB_FEEDBACK_TOKEN_FILE=/etc/dailycheck/github-feedback-token
# DAILYCHECK_GITHUB_REPORT_TOKEN_FILE=/etc/dailycheck/github-report-token
