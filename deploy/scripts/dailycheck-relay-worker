#!/bin/sh
# Install with the protected reviewed source and a pinned Python 3.10+ executable.
set -eu
[ "$#" -eq 1 ] || exit 64
case "$1" in
    start|status|finalize|reconcile|abort|report) ;;
    *) exit 64 ;;
esac
cd /
umask 077
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    /opt/dailycheck-relay/worker-python -I -B -c \
    'import runpy,sys;sys.path.insert(0,"/opt/dailycheck-relay/authority");runpy.run_module("scripts.prod_agent.relay_worker",run_name="__main__")' "$1"
