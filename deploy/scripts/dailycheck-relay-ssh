#!/bin/sh
# Install as a root-owned fixed command. Sudo must preserve only this SSH value.
set -eu
[ "$#" -eq 0 ] || exit 64
[ "${SSH_ORIGINAL_COMMAND:-}" = dailycheck-release-relay-v1 ] || exit 77
cd /
umask 077
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    SSH_ORIGINAL_COMMAND=dailycheck-release-relay-v1 \
    /usr/bin/python3 -I -B -c \
    'import runpy,sys;sys.path.insert(0,"/opt/dailycheck-relay/authority");runpy.run_module("scripts.prod_agent.relay_vps",run_name="__main__")' ssh
